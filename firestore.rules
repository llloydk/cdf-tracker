rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects collection rules
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Payment methods collection rules
    match /paymentMethods/{methodId} {
      allow read, write: if true;
    }

    // Reports collection rules
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Project requests collection rules
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Constituencies collection rules
    match /constituencies/{constituencyId} {
      allow read, write: if true;
    }

    // Applications collection rules
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Live updates / audit logs rules
    match /updates/{updateId} {
      allow read, write: if true;
    }

    // Announcements board rules
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Citizen accounts (subscription credentials) rules
    match /citizens/{citizenId} {
      allow read, write: if true;
    }
  }
}
